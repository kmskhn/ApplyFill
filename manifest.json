{
  "manifest_version": 3,
  "name": "ApplyFill",
  "version": "0.1.0",
  "description": "Fills job application forms from your profile, saved answers and resume. Never submits.",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://openrouter.ai/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.linkedin.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content/util.js", "content/match.js", "content/memory.js", "content/scan.js", "content/fill.js", "content/panel.js", "content/main.js", "content/detect.js"]
    }
  ],
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "action": { "default_title": "ApplyFill settings" },
  "commands": {
    "fill-form": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the job form on this page"
    }
  }
}
